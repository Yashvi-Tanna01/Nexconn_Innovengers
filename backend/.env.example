# ==============================================================================
# ANTAH BACKEND — Production & Staging Environment Configuration
# ==============================================================================

# Database Connection URL:
# Production PostgreSQL (Neon, Supabase, RDS, Render):
DATABASE_URL=postgresql+pg8000://user:password@ep-your-pooler.region.aws.neon.tech/neondb?sslmode=require
# Local fallback:
# DATABASE_URL=sqlite:///./antah.db

ENVIRONMENT=production
JWT_SECRET=generate-a-strong-32-character-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (Comma-separated)
# In production, include your Vercel frontend domain:
CORS_ORIGINS=https://antah.vercel.app,https://yourdomain.com

# Nexconn Chat Credentials
NEXCONN_APP_ID=qf3d5gbjqvk3h
NEXCONN_APP_KEY=qf3d5gbjqvk3h
NEXCONN_APP_SECRET=tkswtS6V24zAXL
NEXCONN_API_BASE_URL=https://api.sg-light-api.com
NEXCONN_AREA_CODE=2

# AI Provider Credentials (OpenRouter / Anthropic)
AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-your-key-here

# Persistent Cloud Storage (Optional for persistent uploads on ephemeral servers)
# Compatible with AWS S3, Cloudflare R2, MinIO, Supabase S3
# AWS_STORAGE_BUCKET_NAME=antah-evidence
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# STORAGE_PUBLIC_URL=https://cdn.yourdomain.com
